# Copy this file to .env.local and fill in your own MySQL password.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=library_db

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=library_nosql

# Use a long, random value (at least 32 characters) for signed login sessions.
SESSION_SECRET=replace_with_a_long_random_secret
